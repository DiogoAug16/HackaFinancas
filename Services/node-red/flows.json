[
  {
    "id": "cloudant-tab",
    "type": "tab",
    "label": "Cloudant gateway",
    "disabled": false,
    "info": "CloudantPlus conecta com URL e API key; o banco é escolhido na rota de escrita."
  },
  {
    "id": "cloudant-connection",
    "type": "cloudantplus",
    "name": "IBM Cloudant",
    "host": "${CLOUDANT_URL}",
    "useapikey": true
  },
  {
    "id": "health-in",
    "type": "http in",
    "z": "cloudant-tab",
    "name": "Cloudant health",
    "url": "/v1/health",
    "method": "get",
    "upload": false,
    "swaggerDoc": "",
    "x": 130,
    "y": 100,
    "wires": [["cloudant-server-info"]]
  },
  {
    "id": "cloudant-server-info",
    "type": "cloudantplus info",
    "z": "cloudant-tab",
    "name": "Cloudant server",
    "cloudant": "cloudant-connection",
    "database": "",
    "service": "_ext_",
    "operation": "server",
    "payonly": false,
    "x": 370,
    "y": 100,
    "wires": [["health-response"]]
  },
  {
    "id": "health-response",
    "type": "function",
    "z": "cloudant-tab",
    "name": "Respond health",
    "func": "const result = msg.payload.result || msg.payload;\nmsg.statusCode = 200;\nmsg.payload = { status: \"ok\", version: result.version };\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 600,
    "y": 100,
    "wires": [["health-out"]]
  },
  {
    "id": "health-out",
    "type": "http response",
    "z": "cloudant-tab",
    "name": "",
    "statusCode": "",
    "headers": {},
    "x": 820,
    "y": 100,
    "wires": []
  },
  {
    "id": "databases-in",
    "type": "http in",
    "z": "cloudant-tab",
    "name": "List Cloudant databases",
    "url": "/v1/databases",
    "method": "get",
    "upload": false,
    "swaggerDoc": "",
    "x": 150,
    "y": 180,
    "wires": [["cloudant-database-list"]]
  },
  {
    "id": "cloudant-database-list",
    "type": "cloudantplus info",
    "z": "cloudant-tab",
    "name": "List databases",
    "cloudant": "cloudant-connection",
    "database": "",
    "service": "_ext_",
    "operation": "dblist",
    "payonly": false,
    "x": 380,
    "y": 180,
    "wires": [["databases-response"]]
  },
  {
    "id": "databases-response",
    "type": "function",
    "z": "cloudant-tab",
    "name": "Respond database list",
    "func": "msg.statusCode = 200;\nmsg.payload = msg.payload.result || msg.payload;\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 620,
    "y": 180,
    "wires": [["databases-out"]]
  },
  {
    "id": "databases-out",
    "type": "http response",
    "z": "cloudant-tab",
    "name": "",
    "statusCode": "",
    "headers": {},
    "x": 840,
    "y": 180,
    "wires": []
  },
  {
    "id": "documents-in",
    "type": "http in",
    "z": "cloudant-tab",
    "name": "Create document",
    "url": "/v1/databases/:database/documents",
    "method": "post",
    "upload": false,
    "swaggerDoc": "",
    "x": 170,
    "y": 260,
    "wires": [["validate-document-target"]]
  },
  {
    "id": "validate-document-target",
    "type": "function",
    "z": "cloudant-tab",
    "name": "Validate database and document",
    "func": "const database = msg.req?.params?.database;\n\nif (!/^[a-z][a-z0-9_$()+/-]*$/.test(database || \"\")) {\n    msg.statusCode = 400;\n    msg.payload = { error: \"A valid lowercase database name is required\" };\n    return [null, msg];\n}\n\nif (!msg.payload || Array.isArray(msg.payload) || typeof msg.payload !== \"object\") {\n    msg.statusCode = 400;\n    msg.payload = { error: \"A JSON object is required\" };\n    return [null, msg];\n}\n\nmsg.database = database;\nreturn [msg, null];",
    "outputs": 2,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 420,
    "y": 260,
    "wires": [["cloudant-document-out"], ["documents-error-out"]]
  },
  {
    "id": "cloudant-document-out",
    "type": "cloudantplus out",
    "z": "cloudant-tab",
    "name": "Insert document",
    "cloudant": "cloudant-connection",
    "database": "",
    "service": "_ext_",
    "payonly": true,
    "operation": "insert",
    "x": 670,
    "y": 240,
    "wires": [["documents-response"]]
  },
  {
    "id": "documents-response",
    "type": "function",
    "z": "cloudant-tab",
    "name": "Respond document creation",
    "func": "msg.statusCode = msg.payload.status || 201;\nmsg.payload = msg.payload.result || msg.payload;\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 910,
    "y": 240,
    "wires": [["documents-out"]]
  },
  {
    "id": "documents-out",
    "type": "http response",
    "z": "cloudant-tab",
    "name": "",
    "statusCode": "",
    "headers": {},
    "x": 1140,
    "y": 240,
    "wires": []
  },
  {
    "id": "documents-error-out",
    "type": "http response",
    "z": "cloudant-tab",
    "name": "",
    "statusCode": "",
    "headers": {},
    "x": 680,
    "y": 290,
    "wires": []
  },
  {
    "id": "cloudant-errors",
    "type": "catch",
    "z": "cloudant-tab",
    "name": "Cloudant errors",
    "scope": ["cloudant-server-info", "cloudant-database-list", "cloudant-document-out"],
    "uncaught": false,
    "x": 140,
    "y": 350,
    "wires": [["cloudant-error-response"]]
  },
  {
    "id": "cloudant-error-response",
    "type": "function",
    "z": "cloudant-tab",
    "name": "Respond Cloudant error",
    "func": "if (!msg.res) { return null; }\nmsg.statusCode = msg.error?.status || 502;\nmsg.payload = { error: \"Cloudant request failed\" };\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 390,
    "y": 350,
    "wires": [["cloudant-error-out"]]
  },
  {
    "id": "cloudant-error-out",
    "type": "http response",
    "z": "cloudant-tab",
    "name": "",
    "statusCode": "",
    "headers": {},
    "x": 640,
    "y": 350,
    "wires": []
  }
]
