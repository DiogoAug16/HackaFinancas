# Gere um valor aleatório longo, por exemplo: openssl rand -hex 32
NODE_RED_CREDENTIAL_SECRET=substitua-por-um-segredo-longo

# Credencial IAM do IBM Cloudant. Nunca exponha estes valores no app iOS.
CLOUDANT_URL=https://seu-endpoint.cloudantnosqldb.appdomain.cloud
CLOUDANT_APIKEY=substitua-pela-chave-iam
CLOUDANT_DATABASE=hackafinancas
